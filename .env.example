# 运行环境变量清单（AGENTS.md §2.1-5）——复制为 .env.local 后填写
# 缺失时进程启动即报错（lib/env.ts assertEnv）。

# 数据库：Neon 主库；也可填本机内嵌库 postgres://postgres:postgres@127.0.0.1:55432/shunlu
DATABASE_URL=

# 演示模式（1 = 开启 /api/demo/*、演示工具条、切号）
DEMO_MODE=1

# 演示接口令牌：公网部署时必须配置，否则 /api/demo/* 一律 403
DEMO_TOKEN=

# 电脑端调试后台 /admin/console 的密码；留空 = 后台关闭（接口 503）
ADMIN_PASSWORD=

# 文件存储驱动：local（本机 .data/uploads）| vercel-blob（线上）
STORAGE_DRIVER=local

# STORAGE_DRIVER=vercel-blob 时必填
BLOB_READ_WRITE_TOKEN=

# 应用对外地址（Vercel 预览地址 / 局域网地址）
APP_URL=http://localhost:3000
